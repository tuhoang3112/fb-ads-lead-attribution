config {
  type: "view",
  schema: "dm_facebook_ads_view",
  description: "Staging: CRM leads (Sales pipelines) with a normalised UTM key"
}

-- Source: the CRM mart (project crm-data-warehouse), Sales pipelines only.
-- Pipeline IDs: 2042 = Sales | Prospecting, 2754 = Nurturing (merged into Sales in the CRM metrics).
WITH crm_leads AS (
  SELECT
    d.deal_id,
    d.created_at,
    DATE(d.created_at, 'Asia/Ho_Chi_Minh') AS lead_date,
    d.deal_status,
    d.deal_value,
    d.course_selected,
    LOWER(TRIM(d.utm_source)) AS utm_source,
    LOWER(TRIM(d.utm_medium)) AS utm_medium,
    -- In the CRM mart the campaign-level UTM is stored in utm_product
    LOWER(TRIM(d.utm_product)) AS utm_campaign,
    LOWER(TRIM(d.utm_content)) AS utm_content
  FROM ${ref({ schema: "dm_rework_crm", name: "fact_deal" })} d
  JOIN ${ref({ schema: "dm_rework_crm", name: "dim_stage" })} s USING (stage_id)
  WHERE s.pipeline_id IN (2042, 2754)
)

SELECT
  *,
  -- Candidate for Facebook attribution = a Facebook source, and not a tag Sales added after the win
  (utm_source IN ('facebook', 'fb') AND COALESCE(utm_medium, '') NOT IN ('inbox', 'zalo')) AS is_facebook_utm,
  IF(utm_campaign IS NULL OR utm_content IS NULL, NULL, CONCAT(utm_campaign, '|', utm_content)) AS utm_key
FROM crm_leads
