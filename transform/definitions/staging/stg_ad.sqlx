config {
  type: "view",
  schema: "dm_facebook_ads_view",
  description: "Staging: ads - latest version per ID, creative ID extracted"
}

SELECT
  id AS ad_id,
  adset_id AS ad_set_id,
  campaign_id,
  account_id,
  name AS ad_name,
  status,
  effective_status,
  JSON_VALUE(creative, '$.id') AS creative_id,
  SAFE_CAST(created_time AS TIMESTAMP) AS created_time,
  SAFE_CAST(updated_time AS TIMESTAMP) AS updated_time
FROM ${ref("ads")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY _airbyte_extracted_at DESC) = 1
