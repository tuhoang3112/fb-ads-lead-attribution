config {
  type: "view",
  schema: "dm_facebook_ads_view",
  description: "Staging: creatives - recovers the CTA link and UTM parameters through several fallbacks. This is the join key to CRM leads"
}

js {
  const { utmParam } = require("includes/fb");
}

WITH creative AS (
  SELECT
    id AS creative_id,
    url_tags,
    -- Caption text: posts built from an image / carousel often carry the link only here
    COALESCE(
      body,
      JSON_VALUE(object_story_spec, '$.link_data.message'),
      JSON_VALUE(object_story_spec, '$.video_data.message'),
      JSON_VALUE(object_story_spec, '$.photo_data.caption')
    ) AS caption,
    link_url,
    object_story_spec
  FROM ${ref("ad_creatives")}
  QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY _airbyte_extracted_at DESC) = 1
),

with_link AS (
  SELECT
    *,
    -- Fallback order: official link fields first, then the first URL typed in the caption.
    COALESCE(
      NULLIF(link_url, ''),
      JSON_VALUE(object_story_spec, '$.link_data.link'),
      JSON_VALUE(object_story_spec, '$.video_data.call_to_action.value.link'),
      JSON_VALUE(object_story_spec, '$.link_data.child_attached_media[0].link'),
      RTRIM(REGEXP_EXTRACT(caption, r'(https?://[^\s]+)'), '.,;:!?)')
    ) AS cta_link,
    CASE
      WHEN NULLIF(link_url, '') IS NOT NULL THEN 'link_url'
      WHEN COALESCE(
             JSON_VALUE(object_story_spec, '$.link_data.link'),
             JSON_VALUE(object_story_spec, '$.video_data.call_to_action.value.link'),
             JSON_VALUE(object_story_spec, '$.link_data.child_attached_media[0].link')
           ) IS NOT NULL THEN 'object_story_spec'
      WHEN REGEXP_EXTRACT(caption, r'(https?://[^\s]+)') IS NOT NULL THEN 'caption_regex'
      ELSE 'none'
    END AS cta_link_source
  FROM creative
),

with_utm AS (
  SELECT
    *,
    ${utmParam("utm_source")} AS utm_source,
    ${utmParam("utm_medium")} AS utm_medium,
    ${utmParam("utm_campaign")} AS utm_campaign,
    ${utmParam("utm_content")} AS utm_content
  FROM with_link
)

SELECT
  creative_id,
  cta_link,
  cta_link_source,
  -- Shortened links (bit.ly, fb.me...) hide the UTM and cannot be parsed
  REGEXP_CONTAINS(cta_link, r'^https?://(bit\.ly|fb\.me|tinyurl\.com|goo\.gl|lnkd\.in|s\.id)/') AS is_short_link,
  utm_source,
  utm_medium,
  utm_campaign,
  utm_content,
  -- Join key to CRM leads. Source / medium are deliberately NOT part of it:
  -- Sales can edit them after the fact (e.g. tag 'inbox'), campaign + content are stable.
  IF(utm_campaign IS NULL OR utm_content IS NULL, NULL, CONCAT(utm_campaign, '|', utm_content)) AS utm_key
FROM with_utm
