config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Fact: bridge between leads and ads. One row per (lead, candidate ad) with a weight. Weights of one lead always sum to 1",
  assertions: { nonNull: ["deal_id", "ad_id", "attribution_weight"] }
}

-- A lead can be linked to an ad when:
--   1. the lead's UTM key (campaign|content) equals the ad's UTM key, and
--   2. the ad had already delivered (had spend data) on or before the lead date.
-- Several ads can share one UTM key (same landing link reused). The lead then cannot be
-- pinned to one ad, so it is split equally across them (weight = 1 / number of candidates).
WITH ad_first_delivery AS (
  SELECT ad_id, MIN(report_date) AS first_delivery_date
  FROM ${ref("fact_ad_insights_daily")}
  WHERE impressions > 0
  GROUP BY ad_id
),

matches AS (
  SELECT l.deal_id, a.ad_id
  FROM ${ref("stg_lead")} l
  JOIN ${ref("dim_ad")} a ON a.utm_key = l.utm_key
  JOIN ad_first_delivery f ON f.ad_id = a.ad_id
  WHERE l.is_facebook_utm
    AND l.lead_date >= f.first_delivery_date
)

SELECT
  deal_id,
  ad_id,
  1 / COUNT(*) OVER (PARTITION BY deal_id) AS attribution_weight
FROM matches
