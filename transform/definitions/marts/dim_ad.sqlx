config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Dimension: ads with course label, CTA link and UTM (the key used to match CRM leads)",
  assertions: { uniqueKey: ["ad_id"], nonNull: ["ad_id"] }
}

-- Naming convention for ads:  <COURSE_CODE> | <content name>   e.g.  DMM | launching_post
-- The part before "|" becomes course_code, the part after becomes content_name.
SELECT
  a.ad_id,
  a.ad_set_id,
  a.campaign_id,
  a.account_id,
  a.ad_name,
  UPPER(TRIM(SPLIT(a.ad_name, '|')[SAFE_OFFSET(0)])) AS course_code,
  TRIM(SPLIT(a.ad_name, '|')[SAFE_OFFSET(1)]) AS content_name,
  a.status,
  a.effective_status,
  a.creative_id,
  cr.cta_link,
  cr.cta_link_source,
  cr.is_short_link,
  cr.utm_source,
  cr.utm_medium,
  cr.utm_campaign,
  cr.utm_content,
  cr.utm_key,
  a.created_time,
  a.updated_time
FROM ${ref("stg_ad")} a
LEFT JOIN ${ref("stg_ad_creative")} cr USING (creative_id)
