config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Dimension: calendar, one row per day. Shared by the ad performance facts and the leads",
  assertions: { uniqueKey: ["date"], nonNull: ["date"] }
}

SELECT
  d AS date,
  EXTRACT(YEAR FROM d) AS year,
  EXTRACT(QUARTER FROM d) AS quarter,
  FORMAT_DATE('%Y-Q%Q', d) AS quarter_year,
  EXTRACT(MONTH FROM d) AS month,
  FORMAT_DATE('%B', d) AS month_name,
  FORMAT_DATE('%Y-%m', d) AS month_year,
  EXTRACT(DAYOFWEEK FROM d) AS day_of_week,
  FORMAT_DATE('%A', d) AS day_name
FROM UNNEST(GENERATE_DATE_ARRAY('2025-01-01', '2030-12-31')) AS d
