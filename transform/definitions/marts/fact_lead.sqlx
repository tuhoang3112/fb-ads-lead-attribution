config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Fact: one row per CRM lead (deal) with its Facebook attribution status",
  assertions: { uniqueKey: ["deal_id"], nonNull: ["deal_id"] }
}

WITH candidates AS (
  SELECT deal_id, COUNT(*) AS candidate_ad_count
  FROM ${ref("fact_lead_attribution")}
  GROUP BY deal_id
)

SELECT
  l.deal_id,
  l.created_at,
  l.lead_date,
  l.deal_status,
  l.deal_value,
  l.course_selected,
  l.utm_source,
  l.utm_medium,
  l.utm_campaign,
  l.utm_content,
  l.utm_key,
  COALESCE(c.candidate_ad_count, 0) AS candidate_ad_count,
  CASE
    WHEN NOT l.is_facebook_utm OR l.utm_key IS NULL THEN 'not_facebook_ads'
    WHEN COALESCE(c.candidate_ad_count, 0) = 0 THEN 'unmatched'
    WHEN c.candidate_ad_count = 1 THEN 'matched'
    ELSE 'ambiguous'
  END AS attribution_status
FROM ${ref("stg_lead")} l
LEFT JOIN candidates c USING (deal_id)
