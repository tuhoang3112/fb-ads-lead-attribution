  STRUCT('prefix', 'Promo', NULL, 'Multi-course (general promo)'),
  STRUCT('prefix', 'Post', NULL, 'Multi-course / Brand content'),

  STRUCT('exact', 'Spreadsheet before after', NULL, 'Spreadsheet Analytics Essentials'),
