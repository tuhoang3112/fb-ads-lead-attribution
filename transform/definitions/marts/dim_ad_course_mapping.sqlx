config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Mapping from ad names to standard course names - maintained by hand, updated when a new ad cannot be mapped (names in this public copy are fictional)"
}

SELECT * FROM UNNEST([
  STRUCT('prefix' AS mapping_type, 'DA' AS ad_key, CAST(NULL AS STRING) AS campaign_pattern, 'Dashboard Design Fundamentals' AS course_selected),
  STRUCT('prefix', 'PDA', NULL, 'Applied Analytics Program'),
  STRUCT('prefix', 'Excel', NULL, 'Spreadsheet Analytics Essentials'),
