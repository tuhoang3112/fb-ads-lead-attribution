config {
  type: "table",
  schema: "dm_facebook_ads",
  description: "Dimension: ad accounts (used for filtering)",
  assertions: { uniqueKey: ["account_id"], nonNull: ["account_id"] }
}

SELECT DISTINCT
  account_id,
  ANY_VALUE(account_name) AS account_name
FROM ${ref("stg_ads_insights")}
GROUP BY account_id
