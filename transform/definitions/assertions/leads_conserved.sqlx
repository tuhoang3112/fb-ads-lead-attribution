config {
  type: "assertion",
  description: "Total leads in fact_ad_lead_daily must equal the number of leads with status matched or ambiguous"
}

WITH attributed AS (
  SELECT SUM(leads) AS leads FROM ${ref("fact_ad_lead_daily")}
),
expected AS (
  SELECT COUNT(*) AS leads FROM ${ref("fact_lead")} WHERE attribution_status IN ('matched', 'ambiguous')
)
SELECT a.leads AS attributed_leads, e.leads AS expected_leads
FROM attributed a, expected e
WHERE ABS(a.leads - e.leads) > 0.001
